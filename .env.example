# 복사해서 셸 환경변수(또는 IDE 실행 설정)로 주입하세요. 실제 값이 든 .env 파일은 커밋 금지.
# 키가 비어 있어도 local 프로필은 가짜 AI 모드로 동작합니다(CLASSMENTO_AI_FAKE=true 기본).

# Claude (이력서 구조화·질문 생성·평가)
ANTHROPIC_API_KEY=
CLASSMENTO_LLM_MODEL=claude-sonnet-5-5

# OpenAI (임베딩, 벡터 검색용)
OPENAI_API_KEY=

# NAVER CLOVA Speech (STT) — 콘솔의 Invoke URL / Secret Key
CLOVA_SPEECH_INVOKE_URL=
CLOVA_SPEECH_SECRET=

# 가짜 AI 모드 (local 기본 true, prod 기본 false)
CLASSMENTO_AI_FAKE=

# 소셜 로그인 (리다이렉트 URI: http://localhost:3000/login/oauth2/code/{google|kakao})
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 관리자 계정 시드 (local 기본: admin@classmento.local / admin1234!)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# DB (기본: jdbc:postgresql://localhost:5433/classmento, classmento/classmento)
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# 업로드 저장 위치 (기본 ./data/uploads)
CLASSMENTO_STORAGE_ROOT=

# 프론트(Next) → 백엔드 프록시 대상 (기본 http://localhost:8080)
BACKEND_URL=
