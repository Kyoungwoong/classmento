# 복사해서 셸 환경변수(또는 IDE 실행 설정)로 주입하세요. 실제 값이 든 .env 파일은 커밋 금지.

# Claude (질문 생성·이력서 구조화·평가)
ANTHROPIC_API_KEY=
CLASSMENTO_LLM_MODEL=claude-sonnet-5-5

# NAVER CLOVA Speech (STT) — 콘솔의 Invoke URL / Secret Key
CLOVA_SPEECH_INVOKE_URL=
CLOVA_SPEECH_SECRET=

# 백엔드 CORS 허용 출처 (쉼표 구분)
CLASSMENTO_CORS_ORIGINS=http://localhost:3000

# prod 프로필 DB
DB_URL=
DB_USERNAME=
DB_PASSWORD=
