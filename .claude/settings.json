{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bash scripts/verify.sh:*)",
      "Bash(pnpm dev)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build)",
      "Bash(pnpm format:*)",
      "Bash(pnpm gen:api)",
      "Bash(./gradlew test:*)",
      "Bash(./gradlew spotlessApply:*)",
      "Bash(./gradlew spotlessCheck:*)",
      "Bash(./gradlew build:*)",
      "Bash(./gradlew bootRun:*)",
      "Bash(git push:*)", 
      "Bash(gh pr merge:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "mcp__context7",
      "mcp__playwright"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Edit(./.env)",
      "Edit(./**/.env)",
      "Edit(./**/.env.local)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "enabledMcpjsonServers": ["context7", "playwright"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/format-hook.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
